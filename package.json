{
  "name": "dsh-colorful-commands",
  "displayName": "多彩命令",
  "description": "按类别给 DSH 的思考、命令、文件读写、搜索等行着色，并可给权限选择等界面控件单独配色；内置中国传统色 / 日本传统色 / 马卡龙色系预设，支持逐类别自定义浅色与深色。",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "blancatora",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "color",
    "colorful",
    "ui"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node src/build-client.mjs",
    "test": "node src/build-client.mjs && node --test test/*.test.mjs",
    "check": "node --check src/index.js && node --check src/config.js && node --check src/classify.js && node --check src/css.js && node --check lib/client.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "file:///home/blancat/Projects/dsh-colorful-commands"
  },
  "private": true
}
