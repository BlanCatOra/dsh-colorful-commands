{
  "name": "dsh-colorful-commands",
  "displayName": "多彩命令",
  "description": "按类别给 DSH 的思考、命令（三级风险）、文件读写、搜索等行着色，并可给权限选择等界面控件单独配色；内置中国传统色（742 色）/ 日本传统色 / 马卡龙三套传统色预设，逐类别可自定义浅色与深色；低饱和 + 明暗两套 + 对比度约束，长时间使用不刺眼。",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "author": "blancatora",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "color",
    "colorful",
    "ui",
    "syntax-highlight"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "docs",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "locale"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node src/build-client.mjs",
    "test": "node src/build-client.mjs && node --test test/*.test.mjs",
    "check": "node --check src/index.js && node --check src/config.js && node --check src/classify.js && node --check src/css.js && node --check lib/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlanCatOra/dsh-colorful-commands.git"
  },
  "homepage": "https://github.com/BlanCatOra/dsh-colorful-commands#readme",
  "bugs": {
    "url": "https://github.com/BlanCatOra/dsh-colorful-commands/issues"
  },
  "private": true,
  "icon": "./icon.svg"
}
